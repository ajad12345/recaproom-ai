# .env.example — placeholders only. Copy to .env and fill in your own values.
# LLM_PROVIDER: groq | gemini | demo   (demo needs no key)
LLM_PROVIDER=demo
GROQ_API_KEY=replace_with_your_own_key
GEMINI_API_KEY=replace_with_your_own_key
# Optional model override (model names change; check the provider docs)
MODEL_NAME=replace_with_a_supported_model_name
# Optional: speech-to-text model for the audio extension (Groq)
WHISPER_MODEL=whisper-large-v3
LOG_LEVEL=INFO
